# ZaloBot environment template.
# Copy to .env and replace every placeholder. Never commit the real .env.
#
#   Linux/macOS : cp .env.example .env
#   Windows CMD : copy .env.example .env
#   PowerShell  : Copy-Item .env.example .env

# ----------------------------------------------------------------- Zalo
# Up to THREE Zalo bot identities run from this one codebase, one process and
# one Firestore database. Each bot is its own identity with its own users,
# chats, token and platform limits.
#
#   BOT_1_TOKEN  (or the legacy BOT_TOKEN)  -> bot1   REQUIRED
#   BOT_2_TOKEN                             -> bot2   optional
#   BOT_3_TOKEN                             -> bot3   optional
#
# A bot whose token is absent is simply disabled — including bot 1. Bot 1 owns
# the LEGACY storage namespace (unprefixed keys), so turning it off leaves that
# existing data with no process reading or writing it. Startup only refuses when
# NO identity is active at all (no bot token AND ZCA disabled).
#
# Duplicate tokens are rejected at startup — two bots sharing a token would mean
# two polling consumers on one identity, causing duplicate inbound messages and
# a fight over the update cursor.
#
# IMPORTANT: adding bots does NOT increase the capacity of the existing bot.
# Zalo's per-bot limits apply to each identity separately.
BOT_TOKEN=your_zalo_bot_token
# BOT_1_TOKEN=your_bot_1_token
# BOT_2_TOKEN=your_bot_2_token
# BOT_3_TOKEN=your_bot_3_token

# Names people TYPE when they call the bot in a group, comma-separated.
#
# Zalo group members can have a nickname that differs from the account name, and
# typing "@Name" by hand does NOT send a structured mention. Without an alias the
# bot sees an untagged message and stays silent (by design). Add the names your
# group actually uses:
#   BOT_ALIASES=Fatherbot
#   BOT_1_ALIASES=Fatherbot,Lịch Học    (per-bot override, takes precedence)
# BOT_ALIASES=

# Monthly outgoing-message warning threshold, tracked PER BOT.
#
# Zalo's Basic plan is documented as 3,000 outgoing messages/month, but it is
# NOT confirmed whether that limit applies per bot, per Zalo account, or per
# something else. This value only drives a warning in the dashboard; it does not
# enforce anything. Set it to whatever you want to be alerted at.
BOT_MONTHLY_MESSAGE_WARNING=3000

# ------------------------------------------------- Performance & observability
#
# Periodic memory logging. RSS is expected to exceed the V8 heap because
# Buffers, sockets, native Firestore/gRPC and WebSocket state live outside it,
# so external and arrayBuffers are logged too.
MEMORY_LOG_ENABLED=false
MEMORY_LOG_INTERVAL_MS=60000
# Log extra diagnostics (queues, provider states, store sizes) above this RSS.
MEMORY_WARN_MB=800
#
# Outbound sends are queued per provider so one broadcast cannot flood every
# bot at once, and so interactive replies are not stuck behind bulk traffic.
OFFICIAL_SEND_CONCURRENCY=8
ZCA_SEND_CONCURRENCY=4
#
# Pacing for bulk traffic (/thongbao, /update, daily schedules, class reminders).
#
# Sending 100+ messages in a few seconds is what makes Zalo throttle: the
# official API answers 429, and a PERSONAL account (ZCA) simply does not create
# the message at all while still returning no error — which is why a broadcast
# could report "sent to 100+ users" while many received nothing.
#
# Messages are now sent one at a time per provider, spaced by these intervals.
# 100 recipients ≈ 2 minutes on an official bot, ≈ 5 minutes on a personal
# account. Do not lower these to "speed things up"; that is the failure mode.
BROADCAST_INTERVAL_MS=1200
BROADCAST_ZCA_INTERVAL_MS=3000
#
# Graceful shutdown budget. Keep below the PM2 kill_timeout in
# ecosystem.config.cjs (15000) so flushing has time to finish.
SHUTDOWN_TIMEOUT_MS=12000

# ------------------------------------------------- ZCA personal account
#
# An ADDITIONAL provider using a PERSONAL Zalo account via zca-js. It runs
# alongside the official bots above; it does not replace them, and it does not
# lift any official Bot Platform limit.
#
# zca-js is an UNOFFICIAL integration. Using it with a personal account may
# carry account and platform compatibility risk. Read the README first.
ZCA_ENABLED=false
# Where the login session is stored. NEVER commit this directory.
ZCA_SESSION_PATH=./data/zca-session
# Reconnect automatically when the listener drops. Session/auth failures are
# never retried blindly; they require a new QR login.
ZCA_AUTO_RECONNECT=true
# Optional label shown on the dashboard when the account name is unavailable.
# ZCA_DISPLAY_NAME=
# Names people type to call this account in a group, comma-separated. Defaults to
# ZCA_DISPLAY_NAME when set. Needed whenever the group nickname differs from the
# Zalo account name — otherwise "@Nickname" is treated as untagged.
# ZCA_ALIASES=Fatherbot
# Language sent to Zalo during login.
ZCA_LANGUAGE=vi
# How long to wait for the account name during startup (never blocks startup).
ZCA_NAME_TIMEOUT_MS=5000

# Temporarily suspend a chat after this many consecutive delivery failures.
CHAT_MAX_CONSECUTIVE_FAILURES=3

# ------------------------------------------------------------ Owner IDs
# Comma-separated administrator identities. Get them with /myid.
# OWNER_CHAT_ID is the bot-platform chat id (official channel notifications).
# OWNER_USER_ID is the Zalo user id — the only one usable for the ZCA notification
# channel of friend requests, because a bot chat id is not a ZCA user id.
OWNER_USER_ID=your_owner_user_id
OWNER_CHAT_ID=your_owner_chat_id

# ------------------------------------------------------------ Dashboard
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_long_random_password
# Prefer ADMIN_PASSWORD_HASH in production. Generate it with:
#   set ADMIN_PASSWORD_TO_HASH (>=12 chars) then run: npm run admin:hash-password
# ADMIN_PASSWORD_HASH=scrypt$...
ADMIN_PORT=6003
ADMIN_BASE_PATH=/zalobot
ADMIN_COOKIE_SECURE=true

# ------------------------------------------- Discord notification integration
# Optional. Error/warning notifications are posted here when set.
DISCORD_WEBHOOK=https://discord.com/api/webhooks/your_webhook

# ---------------------------------------------------------------- Gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash
# Legacy alias still accepted: AI_API_KEY=your_gemini_api_key

# ------------------------------------------------- DeepSeek AI assistant
#
# Conversational assistant on top of the existing command engine. It is OFF
# unless AI_ASSISTANT_ENABLED=true AND DEEPSEEK_API_KEY is set. Missing either
# one leaves every normal command working exactly as before — an exhausted API
# balance or an outage must never break /lich, /nhanlich, /help, ...
#
# Explicit commands are NEVER sent to the API: the deterministic parser handles
# them locally, so tokens are only spent on genuine natural language.
AI_ASSISTANT_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Prompt bounds. Smaller values cost less and reduce the amount of conversation
# content that leaves the server.
AI_MAX_HISTORY_MESSAGES=8
AI_MAX_INPUT_CHARS=8000
# Too low a value truncates the JSON reply mid-way (finish_reason "length") and
# the user sees "chưa hiểu rõ" even though the model understood. 800 is safe.
AI_MAX_OUTPUT_TOKENS=800
AI_MAX_ACTIONS_PER_REQUEST=5

# Cost control. The daily limit is per (bot, chat, user); 0 disables that check.
# The monthly budget is a HARD stop for the current month.
#
# These are DEFAULTS. The dashboard (Settings → Trợ lý AI) can override each one
# at runtime without a restart; leave a field blank there to fall back here.
AI_MAX_REQUESTS_PER_USER_PER_DAY=10
# Optional global daily cap across all users; 0 = no global cap.
AI_MAX_REQUESTS_PER_DAY=0
AI_MONTHLY_BUDGET_USD=2
# Owner accounts skip the per-user daily limit (still bounded by the monthly
# budget). Set false if you want the operator limited like everyone else.
AI_OWNER_BYPASS_LIMIT=true
# Minimum gap between two assistant calls from the same user (ms).
AI_COOLDOWN_MS=3000
# Minimum gap between two "assistant is resting" notices to the SAME user (ms).
# Without this, every single message gets the same canned notice back.
AI_NOTICE_COOLDOWN_MS=900000
# After a global failure (out of balance / bad key), stop calling the API for
# this long instead of retrying on every message.
AI_PROVIDER_COOLDOWN_MS=600000
# Off-topic abuse guard. The assistant only answers questions about LHU
# schedules, notifications and its own commands; anything else is ignored
# silently. Answering "out of scope" still costs tokens, so after N such
# messages in a row from the same user the assistant stops calling the API for
# that user for AI_OFFTOPIC_SILENCE_MS. 0 disables the guard.
AI_OFFTOPIC_SILENCE_AFTER=3
AI_OFFTOPIC_SILENCE_MS=600000

# Timeout / retries for the DeepSeek request.
AI_REQUEST_TIMEOUT_MS=20000
AI_MAX_RETRIES=2

# Group chats: the assistant stays silent unless explicitly enabled. The
# existing mention gate still applies either way.
AI_ENABLE_GROUP_ASSISTANT=false

# How long a destructive action waits for "đồng ý" before it expires.
AI_CONFIRMATION_TTL_MS=120000
# How long a follow-up question ("hôm nay hay hôm sau?") stays answerable with a
# bare reply such as "Hôm sau".
AI_CLARIFICATION_TTL_MS=300000

# Price used ONLY to estimate spend for the budget cap (USD per 1M tokens).
# Update these when DeepSeek changes its published prices.
AI_PRICE_INPUT_PER_1M_USD=0.28
AI_PRICE_OUTPUT_PER_1M_USD=0.42

# -------------------------------------------------------------- Firebase
# Preferred setup: ONE downloaded Firebase Admin JSON file.
# Relative paths resolve from the project directory; absolute paths also work.
FIREBASE_SERVICE_ACCOUNT_FILE=./zalobot-firebase-adminsdk-fbsvc.json
# Example absolute paths:
#   FIREBASE_SERVICE_ACCOUNT_FILE=/home/user/ZaloBot/zalobot-firebase-adminsdk-fbsvc.json
#   FIREBASE_SERVICE_ACCOUNT_FILE=C:\Secure\ZaloBot\zalobot-firebase-adminsdk-fbsvc.json
# Use (default) for the default Firestore database, or a named database ID.
FIREBASE_DATABASE_ID=(default)
FIREBASE_STATE_COLLECTION=bot_state
# Legacy fallback only (kept for older deployments). Prefer the JSON file above.
# FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/to/service-account.json
# FIREBASE_PROJECT_ID=your_project_id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_CONTENT\n-----END PRIVATE KEY-----\n"

# --------------------------------------------------------------- Runtime
TZ=Asia/Ho_Chi_Minh
NODE_ENV=production
PORT=3000
# Grace window used by class-start reminders.
CLASS_START_GRACE_MS=120000
# Runtime caps the effective reminder cache to 60 seconds and at most half of the grace window.
CLASS_START_CACHE_TTL_MS=300000
# Maximum time allowed for a clean SIGINT/SIGTERM shutdown (must stay below PM2 kill_timeout).
SHUTDOWN_TIMEOUT_MS=8000

# ------------------------------------------------------------ Group replies
# Trong nhóm, mặc định bot CHỈ phản hồi khi được tag hoặc khi có lệnh "/...".
# Bật/tắt theo TỪNG nhóm trong dashboard (tab Groups) — không cần biến môi trường.
#
# GROUP_MENTION_ONLY=1                     cổng nhóm bật (mặc định, nên giữ)
# GROUP_MENTION_ONLY=0                     TẮT cổng cho MỌI nhóm: mọi tin đều được
#                                          xử lý. Chỉ dùng khi thật sự muốn vậy —
#                                          cách đúng cho một nhóm hỗ trợ là đổi chế
#                                          độ của chính nhóm đó trong dashboard.
# GROUP_ALLOW_COMMANDS_WITHOUT_MENTION=1   lệnh "/..." vẫn chạy dù không tag
#
# Lời chào tự động KHÔNG BAO GIỜ được gửi vào nhóm, kể cả khi cổng nhóm tắt: lời
# chào trong nhóm là phát cho toàn bộ thành viên.
GROUP_MENTION_ONLY=1
GROUP_ALLOW_COMMANDS_WITHOUT_MENTION=1
