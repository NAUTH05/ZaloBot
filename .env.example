# ZaloBot environment template.
# Copy to .env and replace every placeholder. Never commit the real .env.
#
#   Linux/macOS : cp .env.example .env
#   Windows CMD : copy .env.example .env
#   PowerShell  : Copy-Item .env.example .env

# ----------------------------------------------------------------- Zalo
# Bot token from Zalo Bot Platform.
BOT_TOKEN=your_zalo_bot_token
# Temporarily suspend a chat after this many consecutive delivery failures.
CHAT_MAX_CONSECUTIVE_FAILURES=3

# ------------------------------------------------------------ Owner IDs
# Comma-separated administrator identities. Get them with /myid.
OWNER_USER_ID=your_owner_user_id
OWNER_CHAT_ID=your_owner_chat_id

# ------------------------------------------------------------ Dashboard
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_long_random_password
# Prefer ADMIN_PASSWORD_HASH in production. Generate it with:
#   set ADMIN_PASSWORD_TO_HASH (>=12 chars) then run: npm run admin:hash-password
# ADMIN_PASSWORD_HASH=scrypt$...
ADMIN_PORT=6003
ADMIN_BASE_PATH=/zalobot
ADMIN_COOKIE_SECURE=true

# ------------------------------------------- Discord notification integration
# Optional. Error/warning notifications are posted here when set.
DISCORD_WEBHOOK=https://discord.com/api/webhooks/your_webhook

# ---------------------------------------------------------------- Gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash
# Legacy alias still accepted: AI_API_KEY=your_gemini_api_key

# -------------------------------------------------------------- Firebase
# Preferred setup: ONE downloaded Firebase Admin JSON file.
# Relative paths resolve from the project directory; absolute paths also work.
FIREBASE_SERVICE_ACCOUNT_FILE=./zalobot-firebase-adminsdk-fbsvc.json
# Example absolute paths:
#   FIREBASE_SERVICE_ACCOUNT_FILE=/home/user/ZaloBot/zalobot-firebase-adminsdk-fbsvc.json
#   FIREBASE_SERVICE_ACCOUNT_FILE=C:\Secure\ZaloBot\zalobot-firebase-adminsdk-fbsvc.json
# Use (default) for the default Firestore database, or a named database ID.
FIREBASE_DATABASE_ID=(default)
FIREBASE_STATE_COLLECTION=bot_state
# Legacy fallback only (kept for older deployments). Prefer the JSON file above.
# FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/to/service-account.json
# FIREBASE_PROJECT_ID=your_project_id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_CONTENT\n-----END PRIVATE KEY-----\n"

# --------------------------------------------------------------- Runtime
TZ=Asia/Ho_Chi_Minh
NODE_ENV=production
PORT=3000
# Grace window used by class-start reminders.
CLASS_START_GRACE_MS=120000
# Runtime caps the effective reminder cache to 60 seconds and at most half of the grace window.
CLASS_START_CACHE_TTL_MS=300000
# Maximum time allowed for a clean SIGINT/SIGTERM shutdown (must stay below PM2 kill_timeout).
SHUTDOWN_TIMEOUT_MS=8000
