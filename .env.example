# ZaloBot environment template.
# Copy to .env and replace every placeholder. Never commit the real .env.
#
#   Linux/macOS : cp .env.example .env
#   Windows CMD : copy .env.example .env
#   PowerShell  : Copy-Item .env.example .env

# ----------------------------------------------------------------- Zalo
# Up to THREE Zalo bot identities run from this one codebase, one process and
# one Firestore database. Each bot is its own identity with its own users,
# chats, token and platform limits.
#
#   BOT_1_TOKEN  (or the legacy BOT_TOKEN)  -> bot1   REQUIRED
#   BOT_2_TOKEN                             -> bot2   optional
#   BOT_3_TOKEN                             -> bot3   optional
#
# A bot whose token is absent is simply disabled. Bot 1 is required: it owns the
# legacy storage namespace that existing data lives in.
#
# Duplicate tokens are rejected at startup — two bots sharing a token would mean
# two polling consumers on one identity, causing duplicate inbound messages and
# a fight over the update cursor.
#
# IMPORTANT: adding bots does NOT increase the capacity of the existing bot.
# Zalo's per-bot limits apply to each identity separately.
BOT_TOKEN=your_zalo_bot_token
# BOT_1_TOKEN=your_bot_1_token
# BOT_2_TOKEN=your_bot_2_token
# BOT_3_TOKEN=your_bot_3_token

# Monthly outgoing-message warning threshold, tracked PER BOT.
#
# Zalo's Basic plan is documented as 3,000 outgoing messages/month, but it is
# NOT confirmed whether that limit applies per bot, per Zalo account, or per
# something else. This value only drives a warning in the dashboard; it does not
# enforce anything. Set it to whatever you want to be alerted at.
BOT_MONTHLY_MESSAGE_WARNING=3000

# ------------------------------------------------- Performance & observability
#
# Periodic memory logging. RSS is expected to exceed the V8 heap because
# Buffers, sockets, native Firestore/gRPC and WebSocket state live outside it,
# so external and arrayBuffers are logged too.
MEMORY_LOG_ENABLED=false
MEMORY_LOG_INTERVAL_MS=60000
# Log extra diagnostics (queues, provider states, store sizes) above this RSS.
MEMORY_WARN_MB=800
#
# Outbound sends are queued per provider so one broadcast cannot flood every
# bot at once, and so interactive replies are not stuck behind bulk traffic.
OFFICIAL_SEND_CONCURRENCY=8
ZCA_SEND_CONCURRENCY=4
#
# Graceful shutdown budget. Keep below the PM2 kill_timeout in
# ecosystem.config.cjs (15000) so flushing has time to finish.
SHUTDOWN_TIMEOUT_MS=12000

# ------------------------------------------------- ZCA personal account
#
# An ADDITIONAL provider using a PERSONAL Zalo account via zca-js. It runs
# alongside the official bots above; it does not replace them, and it does not
# lift any official Bot Platform limit.
#
# zca-js is an UNOFFICIAL integration. Using it with a personal account may
# carry account and platform compatibility risk. Read the README first.
ZCA_ENABLED=false
# Where the login session is stored. NEVER commit this directory.
ZCA_SESSION_PATH=./data/zca-session
# Reconnect automatically when the listener drops. Session/auth failures are
# never retried blindly; they require a new QR login.
ZCA_AUTO_RECONNECT=true
# Optional label shown on the dashboard when the account name is unavailable.
# ZCA_DISPLAY_NAME=
# Language sent to Zalo during login.
ZCA_LANGUAGE=vi
# How long to wait for the account name during startup (never blocks startup).
ZCA_NAME_TIMEOUT_MS=5000

# Temporarily suspend a chat after this many consecutive delivery failures.
CHAT_MAX_CONSECUTIVE_FAILURES=3

# ------------------------------------------------------------ Owner IDs
# Comma-separated administrator identities. Get them with /myid.
OWNER_USER_ID=your_owner_user_id
OWNER_CHAT_ID=your_owner_chat_id

# ------------------------------------------------------------ Dashboard
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_long_random_password
# Prefer ADMIN_PASSWORD_HASH in production. Generate it with:
#   set ADMIN_PASSWORD_TO_HASH (>=12 chars) then run: npm run admin:hash-password
# ADMIN_PASSWORD_HASH=scrypt$...
ADMIN_PORT=6003
ADMIN_BASE_PATH=/zalobot
ADMIN_COOKIE_SECURE=true

# ------------------------------------------- Discord notification integration
# Optional. Error/warning notifications are posted here when set.
DISCORD_WEBHOOK=https://discord.com/api/webhooks/your_webhook

# ---------------------------------------------------------------- Gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash
# Legacy alias still accepted: AI_API_KEY=your_gemini_api_key

# -------------------------------------------------------------- Firebase
# Preferred setup: ONE downloaded Firebase Admin JSON file.
# Relative paths resolve from the project directory; absolute paths also work.
FIREBASE_SERVICE_ACCOUNT_FILE=./zalobot-firebase-adminsdk-fbsvc.json
# Example absolute paths:
#   FIREBASE_SERVICE_ACCOUNT_FILE=/home/user/ZaloBot/zalobot-firebase-adminsdk-fbsvc.json
#   FIREBASE_SERVICE_ACCOUNT_FILE=C:\Secure\ZaloBot\zalobot-firebase-adminsdk-fbsvc.json
# Use (default) for the default Firestore database, or a named database ID.
FIREBASE_DATABASE_ID=(default)
FIREBASE_STATE_COLLECTION=bot_state
# Legacy fallback only (kept for older deployments). Prefer the JSON file above.
# FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/to/service-account.json
# FIREBASE_PROJECT_ID=your_project_id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_CONTENT\n-----END PRIVATE KEY-----\n"

# --------------------------------------------------------------- Runtime
TZ=Asia/Ho_Chi_Minh
NODE_ENV=production
PORT=3000
# Grace window used by class-start reminders.
CLASS_START_GRACE_MS=120000
# Runtime caps the effective reminder cache to 60 seconds and at most half of the grace window.
CLASS_START_CACHE_TTL_MS=300000
# Maximum time allowed for a clean SIGINT/SIGTERM shutdown (must stay below PM2 kill_timeout).
SHUTDOWN_TIMEOUT_MS=8000
