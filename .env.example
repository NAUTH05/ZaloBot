# Zalo Bot
BOT_TOKEN=your_zalo_bot_token

# Admin access: comma-separated IDs are supported
OWNER_USER_ID=your_owner_user_id
OWNER_CHAT_ID=your_owner_chat_id
CHAT_MAX_CONSECUTIVE_FAILURES=3
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_long_random_password
# Prefer ADMIN_PASSWORD_HASH in production. Generate it with: npm run admin:hash-password
# ADMIN_PASSWORD_HASH=scrypt$...
ADMIN_PORT=6003
ADMIN_BASE_PATH=/zalobot
ADMIN_COOKIE_SECURE=true

# Optional Discord error/info notifications
DISCORD_WEBHOOK=https://discord.com/api/webhooks/your_webhook

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash

# Firebase Firestore Admin SDK
FIREBASE_PROJECT_ID=zalobot-e98a3
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@zalobot-e98a3.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_CONTENT\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_ID=(default)
FIREBASE_STATE_COLLECTION=bot_state

# Optional: use a service-account JSON instead of the three Firebase env vars above
# FIREBASE_SERVICE_ACCOUNT_PATH=/opt/zalobot/firebase-service-account.json

# Runtime
TZ=Asia/Ho_Chi_Minh
NODE_ENV=production
CLASS_START_GRACE_MS=120000
CLASS_START_CACHE_TTL_MS=300000
